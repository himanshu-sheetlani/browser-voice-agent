{
  "manifest_version": 3,
  "name": "Voice Browser Agent",
  "version": "0.1.0",
  "description": "AI agent that interacts with web pages through voice commands",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "action": {
    "default_title": "Voice Browser Agent",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}